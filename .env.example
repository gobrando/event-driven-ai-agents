# No variables are required for npm run demo or offline tests.
# Generate separate random values; never use a sample value as a credential.
EVENT_WEBHOOK_SECRET=
WORKER_TOKEN=
JOB_DB=.state/jobs.sqlite
# Trigger CLIs and the worker can also receive --db explicitly.
HOST=127.0.0.1
PORT=8787

# Optional live Airtable read-only polling (off by default).
ALLOW_LIVE_TRIGGERS=false
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_VIEW=
AIRTABLE_READY_FIELD=Ready
AIRTABLE_REVISION_FIELD=Run revision
AIRTABLE_TITLE_FIELD=Title
AIRTABLE_BODY_FIELD=Body
AGENT_REPOSITORY_KEY=demo
# Set only inside an integration that verified the GitHub actor's authority.
GITHUB_TRIGGER_AUTHORIZED=false

# Programmatic Codex execution also requires an actual external $1 budget
# enforcer; this flag alone cannot launch paid work in the stock CLI.
ALLOW_CODEX=false
ALLOW_GIT_WRITES=false
# GitHub credentials belong to an operator's credential store / Actions secrets.
# Never put provider API keys in repository test environments.
