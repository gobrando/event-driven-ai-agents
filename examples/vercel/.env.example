# All values are placeholders. Keep .env.local untracked and server-side.
# Offline mock/tests require none of these variables.
POC_LIVE_ENABLED=false
POC_TEST_DATA_ONLY=false
POC_ALLOW_DB_WRITES=false
POC_ALLOW_SUBSCRIPTION_WRITES=false
LLM_ENABLED=false

# Dedicated disposable test database, shared by receiver and daemon.
DATABASE_URL=

# Vercel supplies these in production (enable system environment variables).
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
VERCEL_ENV=production
VERCEL_TARGET_ENV=production
# Local/admin scripts: short-lived OIDC token for the approved environment.
VERCEL_OIDC_TOKEN=
# Daemons receive a rotating token file. Never hard-code its contents/path.
VERCEL_OIDC_TOKEN_FILE=
QUEUE_REGION=iad1

# Connector and HTTPS MCP URL confirmed from the approved test account.
CONNECT_CONNECTOR=
MCP_SERVER_URL=
CONNECT_TOKEN_PARAMS_JSON='{"subject":{"type":"app"}}'
MCP_EVENT_NAME=synthetic.issue.created
MCP_EVENT_ARGUMENTS_JSON='{}'
# Generate/persist one key per approved creation intent; reuse on all retries.
MCP_IDEMPOTENCY_KEY=
# Returned Connect ID (not provider ID), for inspect/stop.
MCP_SUBSCRIPTION_ID=
